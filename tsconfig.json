{
"compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": "./src",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@db/*": ["db/*"],
      "@migrations/*": ["migrations/*"],
      "@mocks/*": ["mocks/*"],
      "@routes/*": ["routes/*"]
    }
  }
}
